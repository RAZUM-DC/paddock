#!/usr/bin/env node
// git credential helper for Paddock harnesses (installed as /usr/local/bin/git-credential-paddock, wired in
// /etc/gitconfig). On `get` it asks web for the token of a git account the user added in Settings → Git:
//   POST ${PADDOCK_WEB_URL:-http://web:3000}/api/harness/git-credential {protocol, host, path}
//   Authorization: Bearer <this harness's capability token, ${PADDOCK_WS_TOKEN_FILE:-/run/secrets/ws-token}>
// and prints username=/password= for git. No match or any error: prints nothing, so git goes on as if there were
// no helper (and fails as usual). `store` and `erase` do nothing: accounts are managed in Paddock only.
// Talks to web directly with node:http, never through HTTP(S)_PROXY (web is on the harness's own network).
// Never prints or logs the token; errors go to stderr only with PADDOCK_GIT_DEBUG=1, and without the token.
// PADDOCK_GIT_CREDENTIALS=0 switches it off.
// CommonJS on purpose: the file has no extension, and that is how node runs it everywhere.
"use strict";
const { request, Agent } = require("node:http");
const { readFileSync } = require("node:fs");

const TIMEOUT_MS = 10_000;
const debug = (msg) => process.env.PADDOCK_GIT_DEBUG === "1" && process.stderr.write(`git-credential-paddock: ${msg}\n`);

// git's credential format: key=value lines, ended by an empty line or EOF. Repeated keys (wwwauth[]) keep the first.
function parseCredentialInput(text) {
  const out = {};
  for (const line of text.split("\n")) {
    const l = line.replace(/\r$/, "");
    if (l === "") break;
    const i = l.indexOf("=");
    if (i <= 0) continue;
    const k = l.slice(0, i);
    if (!(k in out)) out[k] = l.slice(i + 1);
  }
  return out;
}

// What git reads back. A value with a line break or NUL would inject fields: such an answer is dropped entirely.
function formatCredential(c) {
  if (!c || typeof c.username !== "string" || typeof c.password !== "string" || !c.password) return "";
  if (/[\r\n\0]/.test(c.username + c.password)) return "";
  return `username=${c.username}\npassword=${c.password}\n`;
}

const readStdin = () =>
  new Promise((resolve) => {
    let s = "";
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (d) => (s += d));
    process.stdin.on("end", () => resolve(s));
    process.stdin.on("error", () => resolve(s));
  });

function ask(query) {
  let token = "";
  try {
    token = readFileSync(process.env.PADDOCK_WS_TOKEN_FILE || "/run/secrets/ws-token", "utf8").trim();
  } catch {
    return Promise.resolve(null);
  }
  if (!token) return Promise.resolve(null);
  const url = new URL("/api/harness/git-credential", process.env.PADDOCK_WEB_URL || "http://web:3000");
  if (url.protocol !== "http:") return Promise.resolve(null);
  const body = Buffer.from(JSON.stringify(query));
  return new Promise((resolve) => {
    const req = request(url, {
      method: "POST",
      // An own agent: never a global proxy agent, whatever the environment says.
      agent: new Agent({ keepAlive: false }),
      headers: { authorization: `Bearer ${token}`, "content-type": "application/json", "content-length": body.length },
      timeout: TIMEOUT_MS,
    }, (res) => {
      let text = "";
      res.setEncoding("utf8");
      res.on("data", (d) => (text += d.length + text.length > 64 * 1024 ? "" : d));
      res.on("end", () => {
        if (res.statusCode !== 200) {
          debug(`web answered ${res.statusCode}`);
          return resolve(null);
        }
        try {
          resolve(JSON.parse(text));
        } catch {
          resolve(null);
        }
      });
      res.on("error", () => resolve(null));
    });
    req.on("timeout", () => {
      debug("timeout");
      req.destroy();
    });
    req.on("error", (e) => {
      debug(e.code ?? "request failed");
      resolve(null);
    });
    req.end(body);
  });
}

async function main() {
  const op = process.argv[2];
  if (op !== "get") return; // store, erase: nothing to do
  const input = parseCredentialInput(await readStdin());
  if (process.env.PADDOCK_GIT_CREDENTIALS === "0") return;
  // Tokens only ever go over https to the remote.
  if (input.protocol !== "https" || !input.host) return;
  const answer = await ask({ protocol: input.protocol, host: input.host, path: input.path ?? "" });
  process.stdout.write(formatCredential(answer));
}

if (require.main === module) main().catch(() => {}).finally(() => (process.exitCode = 0));
else module.exports = { parseCredentialInput, formatCredential };
